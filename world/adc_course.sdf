<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.6">
  <!-- World name is kept as "silesia_ring" so simulation.launch.py spawn/bridge names still match. -->
  <world name="silesia_ring">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />
    <physics type="ode"><real_time_update_rate>1000</real_time_update_rate><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <spherical_coordinates><surface_model>EARTH_WGS84</surface_model><latitude_deg>50.3568</latitude_deg><longitude_deg>18.4027</longitude_deg><elevation>270.0</elevation><heading_deg>0</heading_deg></spherical_coordinates>
    <gravity>0 0 -9.81</gravity>
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><pose>0 0 200 0 0 0</pose><diffuse>0.92 0.90 0.85 1</diffuse><specular>0.12 0.12 0.12 1</specular><direction>-0.4 0.3 -0.85</direction></light>
    <light name="fill" type="directional"><cast_shadows>false</cast_shadows><pose>0 0 80 0 0 0</pose><diffuse>0.50 0.53 0.58 1</diffuse><specular>0 0 0 1</specular><direction>0 0 -1</direction></light>
