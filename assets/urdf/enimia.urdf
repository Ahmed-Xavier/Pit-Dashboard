<?xml version="1.0"?>
<!--
  ENIMIA - Black Edition (ENIM Team Tunisia) - Prototype Shell Eco-marathon      v3 (surface lissee)
  Carrosserie reconstruite a partir des silhouettes des vues de dessus et de cote :
    - profil de toit / bas de caisse releve pixel par pixel sur la vue de cote
    - largeur (plan) relevee sur la vue de dessus
    - 2 carenes de roues avant (contour releve sur la vue de cote + vue de dessus)
    - vitrage (cockpit + vitres laterales) et bord de fuite rouge separes
  v3 : profils C2 (B-splines), raccords carenes/fuselage arrondis, lissage de Taubin,
       maillages COLLADA (.dae) avec normales par sommet -> ombrage lisse dans RViz/Gazebo.
       Copies STL (ombrage plat) dans meshes/stl/ pour les outils qui ne lisent pas le DAE.
  Dimensions : L 2684 x l 770 x h 695 mm, empattement 1704 mm,
               voie avant 567 mm, masse 25 kg
  Porte-a-faux : avant 593 mm, arriere 387 mm
  Roues : avant R 210 mm (limite par la carene), arriere R 180 mm (arc du pneu)

  Arbre cinematique :
    base_footprint (sol, milieu de l'empattement)
      └─ base_link (chassis, a hauteur d'axe avant)
           ├─ body_link               (coque + vitrage + bord de fuite, fixe : contient tout)
           ├─ front_left_steer_link   (revolute)   └─ front_left_wheel_link  (continuous)
           ├─ front_right_steer_link  (revolute)   └─ front_right_wheel_link (continuous)
           └─ rear_wheel_link         (continuous, motrice)
  Reperes REP-103 : X avant, Y gauche, Z haut. Unites SI.
-->
<robot name="enimia_black">

  <!-- ===================== Materiaux ===================== -->
  <material name="carbon_black"><color rgba="0.07 0.07 0.08 0.55"/></material>
  <material name="glass"><color rgba="0.20 0.32 0.40 0.35"/></material>
  <material name="tail_red"><color rgba="0.80 0.08 0.08 0.9"/></material>
  <material name="aluminium"><color rgba="0.75 0.76 0.78 1.0"/></material>
  <material name="tire"><color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="rim"><color rgba="0.82 0.82 0.84 1.0"/></material>
  <material name="floor"><color rgba="0.35 0.30 0.70 1.0"/></material>
  <material name="battery"><color rgba="0.85 0.80 0.15 1.0"/></material>
  <material name="lidar_body"><color rgba="0.12 0.14 0.18 1.0"/></material>
  <material name="gps_white"><color rgba="0.92 0.92 0.92 1.0"/></material>
  <material name="pcb_green"><color rgba="0.05 0.45 0.20 1.0"/></material>

  <!-- ===================== Base ===================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.21" rpy="0 0 0"/>
  </joint>

  <!-- Chassis : plancher, traverse avant, colonne de direction, arceau, bras arriere, batterie -->
  <link name="base_link">
    <visual>
      <origin xyz="0.0955 0.0000 -0.0850" rpy="0 0 0"/>
      <geometry><box size="1.3 0.28 0.02"/></geometry>
      <material name="floor"/>
    </visual>
    <visual>
      <origin xyz="0.8520 0.0000 0.0000" rpy="0 0 0"/>
      <geometry><box size="0.04 0.48 0.03"/></geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="0.8020 0.0000 0.0000" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.16"/></geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="0.4455 0.0000 0.3400" rpy="0 0 0"/>
      <geometry><box size="0.03 0.39 0.03"/></geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="0.4455 0.1800 0.1500" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 0.39"/></geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="0.4455 -0.1800 0.1500" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 0.39"/></geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="-0.7020 0.0350 -0.0575" rpy="0 0.18 0"/>
      <geometry><box size="0.31 0.015 0.025"/></geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="-0.7020 -0.0350 -0.0575" rpy="0 0.18 0"/>
      <geometry><box size="0.31 0.015 0.025"/></geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="-0.5320 0.0000 -0.0300" rpy="0 0 0"/>
      <geometry><box size="0.22 0.07 0.05"/></geometry>
      <material name="battery"/>
    </visual>
    <collision>
      <origin xyz="0.0955 0 -0.0850" rpy="0 0 0"/>
      <geometry><box size="1.3 0.28 0.02"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.05 0 -0.050" rpy="0 0 0"/>
      <mass value="12.7"/>
      <inertia ixx="0.137583" ixy="0" ixz="0" iyy="2.42358" iyz="0" izz="2.4765"/>
    </inertial>
  </link>

  <!-- ===================== Coque (corps) ===================== -->
  <!-- Maillages exprimes dans le repere sol (origine au milieu de l'empattement) -->
  <link name="body_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://vehicle_description/meshes/body_shell.dae"/></geometry>
      <material name="carbon_black"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://vehicle_description/meshes/canopy.dae"/></geometry>
      <material name="glass"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://vehicle_description/meshes/tail_tip.dae"/></geometry>
      <material name="tail_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://vehicle_description/meshes/body_collision.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.1939 0 0.329146" rpy="0 0 0"/>
      <mass value="7.0"/>
      <inertia ixx="0.587735" ixy="0.00022506" ixz="0.084203" iyy="3.65022" iyz="0" izz="3.67245"/>
    </inertial>
  </link>

  <joint name="body_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body_link"/>
    <origin xyz="0 0 -0.21" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Roue avant gauche (dans sa carene) ===================== -->
  <link name="front_left_steer_link">
    <visual>
      <origin xyz="0 -0.040 0" rpy="0 0 0"/>
      <geometry><box size="0.06 0.04 0.10"/></geometry>
      <material name="aluminium"/>
    </visual>
    <inertial>
      <origin xyz="0 -0.040 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.000386667" ixy="0" ixz="0" iyy="0.000453333" iyz="0" izz="0.000173333"/>
    </inertial>
  </link>

  <joint name="front_left_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steer_link"/>
    <origin xyz="0.8520 0.2835 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.21" upper="0.21" effort="20" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="front_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.21" length="0.035"/></geometry>
      <material name="tire"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.175" length="0.039"/></geometry>
      <material name="rim"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.21" length="0.035"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0179333" ixy="0" ixz="0" iyy="0.0356625" iyz="0" izz="0.0179333"/>
    </inertial>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steer_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="40"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <!-- ===================== Roue avant droite (dans sa carene) ===================== -->
  <link name="front_right_steer_link">
    <visual>
      <origin xyz="0 0.040 0" rpy="0 0 0"/>
      <geometry><box size="0.06 0.04 0.10"/></geometry>
      <material name="aluminium"/>
    </visual>
    <inertial>
      <origin xyz="0 0.040 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.000386667" ixy="0" ixz="0" iyy="0.000453333" iyz="0" izz="0.000173333"/>
    </inertial>
  </link>

  <joint name="front_right_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_steer_link"/>
    <origin xyz="0.8520 -0.2835 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.21" upper="0.21" effort="20" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="front_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.21" length="0.035"/></geometry>
      <material name="tire"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.175" length="0.039"/></geometry>
      <material name="rim"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.21" length="0.035"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0179333" ixy="0" ixz="0" iyy="0.0356625" iyz="0" izz="0.0179333"/>
    </inertial>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steer_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="40"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <!-- ===================== Roue arriere motrice (moteur-roue) ===================== -->
  <link name="rear_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.18" length="0.035"/></geometry>
      <material name="tire"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.145" length="0.039"/></geometry>
      <material name="rim"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.07" length="0.06"/></geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.18" length="0.035"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.0142319" ixy="0" ixz="0" iyy="0.02732" iyz="0" izz="0.0142319"/>
    </inertial>
  </link>

  <joint name="rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_wheel_link"/>
    <origin xyz="-0.8520 0 -0.030" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="15" velocity="40"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <!-- ===================== Capteurs (sur le toit) ===================== -->
  <!--
    Repere REP-103 : X avant, Y gauche, Z haut.
    Une plaque de montage est posee sur le sommet du toit (point haut de la coque : z_sol = 0.694 m,
    plat sur environ x = -0.15 a +0.30 m et |y| < 0.10 m). Tout est monte dessus :
      - LiDAR sur un petit mat, au-dessus du toit pour avoir 360 degres libres,
        incline de 8 deg vers l'avant (+pitch autour de Y) pour voir les petits cones ;
      - GPS derriere le LiDAR, plus bas que le plan de scan (le LiDAR incline ne le voit jamais) ;
      - IMU a cote du LiDAR (cote gauche), a plat, axes alignes sur le vehicule (rpy = 0).
    Positions de simulation : a remplacer par les mesures reelles des supports.
  -->
  <link name="sensor_mount_link">
    <visual>
      <origin xyz="0 0 -0.003" rpy="0 0 0"/>
      <geometry><box size="0.30 0.20 0.006"/></geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="0.070 0 0.027" rpy="0 0 0"/>
      <geometry><cylinder radius="0.012" length="0.054"/></geometry>
      <material name="aluminium"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0006817" ixy="0" ixz="0" iyy="0.001515" iyz="0" izz="0.002167"/>
    </inertial>
  </link>

  <joint name="sensor_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_mount_link"/>
    <origin xyz="0.050 0.000 0.492" rpy="0 0 0"/>
  </joint>

  <!-- LiDAR (RPLIDAR A1M8) : origine = plan de scan. +8 deg de pitch => l'axe X du LiDAR pointe vers le sol, devant. -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0355" length="0.041"/></geometry>
      <material name="lidar_body"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.17"/>
      <inertia ixx="7.737e-05" ixy="0" ixz="0" iyy="7.737e-05" iyz="0" izz="0.0001071"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="sensor_mount_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.070 0.000 0.075" rpy="0 0.07 0"/>
  </joint>

  <!-- GPS/GNSS (antenne GT-U7) : origine = sommet de l'antenne, derriere le LiDAR, sur la ligne mediane. -->
  <link name="gps_link">
    <visual>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 0.01"/></geometry>
      <material name="gps_white"/>
    </visual>
    <inertial>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="2.5e-06" ixy="0" ixz="0" iyy="2.5e-06" iyz="0" izz="4.5e-06"/>
    </inertial>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="sensor_mount_link"/>
    <child link="gps_link"/>
    <origin xyz="-0.100 0.000 0.010" rpy="0 0 0"/>
  </joint>

  <!-- IMU (BNO055) : a plat sur la plaque, a gauche du LiDAR, axes alignes sur base_link. -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <geometry><box size="0.027 0.020 0.004"/></geometry>
      <material name="pcb_green"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1.733e-07" ixy="0" ixz="0" iyy="3.104e-07" iyz="0" izz="4.704e-07"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="sensor_mount_link"/>
    <child link="imu_link"/>
    <origin xyz="0.070 0.070 0.000" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Gazebo (adherence pneus) ===================== -->
  <gazebo reference="front_left_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="front_right_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="rear_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>

  <!-- Gazebo Sim : publie les etats des articulations (direction + roues) pour /joint_states via ros_gz_bridge -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>


  <!-- cmd_vel drive plugins: rear wheel velocity, front steering, ground-truth odometry -->
  <gazebo>
    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>rear_wheel_joint</joint_name>
      <topic>/enimia/rear_wheel_cmd</topic>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>front_left_steer_joint</joint_name>
      <topic>/enimia/steer_left_cmd</topic>
      <p_gain>10</p_gain>
      <i_gain>0</i_gain>
      <d_gain>1</d_gain>
      <cmd_max>20</cmd_max>
      <cmd_min>-20</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>front_right_steer_joint</joint_name>
      <topic>/enimia/steer_right_cmd</topic>
      <p_gain>10</p_gain>
      <i_gain>0</i_gain>
      <d_gain>1</d_gain>
      <cmd_max>20</cmd_max>
      <cmd_min>-20</cmd_min>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/enimia/odom</odom_topic>
      <tf_topic>/enimia/tf</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>

  <!-- ===================== Gazebo Sensors ===================== -->
  <!--
    Load the sensor systems:
    - Sensors: rendering-based sensors (gpu_lidar, cameras)
    - Imu: IMU sensor plugin
    - NavSat: GPS / NavSat sensor plugin
  -->
  <!--
    2-D LiDAR (RPLIDAR A1M8 approximation).
    360°, 10 Hz, 0.15–12 m, 1° resolution.
    Topic: /lidar_link/scan  (bridged to /scan in simulation.launch.py).
    The joint has rpy="0 0.07 0" (+4° pitch) so the scan plane is slightly
    tilted — this matches the physical mount. The bridge delivers a flat
    LaserScan; the tilt is negligible for 2D obstacle detection.
  -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/lidar_link/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise type="gaussian">
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!--
    IMU (BNO055 approximation).
    100 Hz, small Gaussian noise on gyro and accel.
    Topic: /imu_link/imu  (bridged to /imu/data in simulation.launch.py).
    imu_link axes are aligned with base_link (rpy=0) so no additional
    rotation is needed in ekf_local.yaml / ekf_global.yaml.
  -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/imu_link/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!--
    GPS/GNSS (GT-U7 approximation).
    5 Hz. The world's <spherical_coordinates> block sets the origin at
    Kamień Śląski so fixes land at the correct lat/lon.
    Topic: /gps_link/navsat  (bridged to /fix in simulation.launch.py).
  -->
  <gazebo reference="gps_link">
    <sensor name="navsat" type="navsat">
      <topic>/gps_link/navsat</topic>
      <gz_frame_id>gps_link</gz_frame_id>
      <update_rate>5</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

</robot>
